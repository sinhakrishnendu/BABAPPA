#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'Arabidopsis_thaliana'
[2] 'Brassica_rapa'
[3] 'Glycine_max'
[4] 'Oryza_sativa'
[5] 'Sorghum_bicolor'
[6] 'Brachypodium_distachyon'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=9;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	100	 6,
	100	 4 6,
	100	 5,
	100	 1 2 3,
	100	 1 2,
	100	 1,
;
END; [Splits]

